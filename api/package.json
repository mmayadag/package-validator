{
  "name": "package-validator-api",
  "version": "0.1.0",
  "description": "Reports outdated package.json dependencies of a GitHub repository",
  "author": "Murat Mayadağ",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@sendgrid/mail": "^8.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^16.11.0",
    "graphql-request": "^7.4.0",
    "helmet": "^8.3.0",
    "npm-check-updates": "^23.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.2",
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
