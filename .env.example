# GitHub GraphQL API (required)
GITHUB_ENDPOINT=https://api.github.com/graphql
TOKEN=ghp_your_github_token

# Where the validator writes scratch clones inside the api container
TEMP_PATH=./tmp

# SendGrid (optional — leave empty to disable email reports)
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_SUBJECT=Dependency report

# Host port for the UI (docker compose)
UI_PORT=8080
