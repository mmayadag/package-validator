# GitHub token for the GraphQL API (required)
TOKEN=ghp_your_github_token
# GITHUB_ENDPOINT=https://api.github.com/graphql

# SendGrid: the report is emailed only when both values are set
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_SUBJECT=Dependency report

# Host port for the UI container (docker compose)
UI_PORT=8080

# Local development without Docker
# PORT=3288
# DATABASE_PATH=data/package-validator.db
# CORS_ORIGIN=http://localhost:5173
